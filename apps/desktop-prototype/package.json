{
  "name": "ice-plan-studio-prototype",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:plan-ir": "node scripts/verify-plan-ir.cjs",
    "verify:plan-ir-source-pages": "node scripts/verify-plan-ir-source-pages.cjs",
    "verify:preview-equivalence": "node scripts/verify-preview-equivalence.mjs",
    "verify:rules": "node scripts/verify-rule-engine.mjs",
    "verify:body-layout-v2-baseline": "node scripts/verify-body-layout-v2-baseline.mjs",
    "verify:body-layout-v2-decisions": "node scripts/verify-body-layout-v2-decisions.mjs",
    "verify:body-layout-v2-rendering": "node scripts/verify-body-layout-v2-rendering.mjs",
    "verify:body-layout-v2-hwpx": "python -B scripts/verify-body-layout-v2-hwpx.py",
    "verify:workspace-packages": "node scripts/verify-workspace-packages.cjs",
    "regenerate:migrated-fixtures": "node scripts/regenerate-migrated-fixtures.cjs",
    "regenerate:regression": "py test-data/regression-corpus/regenerate.py",
    "verify:app-render": "node scripts/verify-app-render.mjs \"release/win-unpacked/ICE Plan Studio.exe\"",
    "verify:workflow-walk": "node scripts/verify-workflow-walk.mjs \"release/win-unpacked/ICE Plan Studio.exe\"",
    "verify:adaptive-layout": "py test-data/adaptive-layout/gate.py --com",
    "calibrate:layout-measure": "py test-data/adaptive-layout/calibrate.py --com",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --dir && npm run verify:app-render && npm run verify:workflow-walk",
    "dist:installer": "npm run dist:win && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "adm-zip": "0.5.16",
    "kordoc": "4.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "38.1.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "kr.go.ice.iceplanstudio",
    "productName": "ICE Plan Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "scripts/**/*",
      "hwpx-toolkit/**/*",
      "!scripts/__pycache__",
      "!hwpx-toolkit/scripts/__pycache__",
      "!**/node_modules/onnxruntime-node/**",
      "!**/node_modules/@huggingface/**",
      "!**/node_modules/sharp/**",
      "!**/node_modules/@img/**",
      "!**/node_modules/pdfjs-dist/**",
      "!**/node_modules/@napi-rs/**",
      "!**/node_modules/@hyzyla/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ICE Plan Studio"
    },
    "asarUnpack": [
      "scripts/**/*",
      "hwpx-toolkit/**/*"
    ]
  }
}
